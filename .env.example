# Copy to .env and fill in. Tiers whose provider key is empty are skipped automatically.
# Structure (roles, chain, peers) lives in config.yaml; these values override it.

# --- Provider keys -----------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Gateway -------------------------------------------------------------------
# Shared tailnet key: every /v1/* call needs "Authorization: Bearer <GATEWAY_API_KEY>".
# Strongly recommended whenever GATEWAY_HOST is not 127.0.0.1.
GATEWAY_API_KEY=
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8000
# REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

# --- Client side ---------------------------------------------------------------
# Key presented to other gateways (defaults to GATEWAY_API_KEY).
# MAGENT_API_KEY=
# MAGENT_DEFAULT_NODE=acer-worker

# --- Node / local LLM ----------------------------------------------------------
# MAGENT_NODE_NAME=acer-worker
# MAGENT_ROLES=gateway,llm,client
# LLM_RUNTIME=ollama
# LLM_MODEL=qwen2.5:3b

# --- Legacy (v0.1) chain override, replaces config.yaml `chain` when set ---------
# MODEL_CHAIN=free:gemini/gemini-2.5-flash,free:openrouter/openrouter/free,paid:openai/gpt-6-luna

# --- Graph memory ----------------------------------------------------------------
# MEMORY_ENABLED=true
# MEMORY_DB_PATH=agent_memory.db
