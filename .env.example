# Copy to .env and fill in. Tiers whose provider key is empty are skipped automatically.

# --- Provider keys -----------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Fallback chain ------------------------------------------------------------
# Comma-separated, tried in order. Optional "free:" / "paid:" prefix labels the tier
# (returned in the X-Gateway-Tier response header).
MODEL_CHAIN=free:gemini/gemini-2.5-flash,free:openrouter/openrouter/free,paid:openai/gpt-6-luna
REQUEST_TIMEOUT=60

# --- Gateway -------------------------------------------------------------------
# When set, every /v1/* call needs "Authorization: Bearer <GATEWAY_API_KEY>".
# Strongly recommended whenever the gateway listens on 0.0.0.0.
GATEWAY_API_KEY=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
LOG_LEVEL=INFO

# --- Graph memory ----------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_DB_PATH=agent_memory.db
MEMORY_RECENT_LIMIT=6
MEMORY_RELATED_LIMIT=4
MEMORY_SNIPPET_CHARS=500
