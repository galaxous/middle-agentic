#!/bin/sh
# middle-agentic installer (macOS, Linux, Raspberry Pi).
# Installs magent with pipx from a GitHub Release and checks the wheel's SHA-256 before installing.
#   client (default): runs `magent client-setup`  (asks for gateway address and key, verifies them)
#   gateway:          runs `magent gateway-setup` (serves memory and models on this machine)
# Usage:
#   curl -fsSL <release>/install.sh | sh
#   curl -fsSL <release>/install.sh | sh -s -- --role gateway
#   curl -fsSL <release>/install.sh | MAGENT_DATA_DIR=~/magent-data sh -s -- --role gateway
#
# Everything is inside main(): when this script arrives through a pipe, sh reads it as it runs,
# so a command that reads stdin would otherwise consume the rest of the script.
set -eu

VERSION="@VERSION@"
WHEEL="@WHEEL@"
SHA256="@SHA256@"
URL="https://github.com/galaxous/middle-agentic/releases/download/v${VERSION}/${WHEEL}"
PIPX_VENV="${HOME}/.local/share/magent-pipx"

say() { printf '%s\n' "$*"; }
die() { printf 'hata: %s\n' "$*" >&2; exit 1; }

# pipx lives in its own venv, so Homebrew's Python is never touched and PEP 668 does not matter.
ensure_pipx() {
  if command -v pipx >/dev/null 2>&1; then
    PIPX="pipx"
    return 0
  fi
  say "pipx kuruluyor ($PIPX_VENV)..."
  if ! python3 -m venv "$PIPX_VENV" </dev/null >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      sudo apt-get update </dev/null && sudo apt-get install -y python3-venv </dev/null \
        || die "python3-venv kurulamadı; 'sudo apt-get install python3-venv' ile kurup tekrar deneyin"
      python3 -m venv "$PIPX_VENV" </dev/null || die "venv oluşturulamadı ($PIPX_VENV)"
    else
      die "venv oluşturulamadı ($PIPX_VENV); python3 venv modülünü kurup tekrar deneyin"
    fi
  fi
  "$PIPX_VENV/bin/pip" install --quiet --upgrade pipx </dev/null || die "pipx kurulamadı"
  PIPX="$PIPX_VENV/bin/pipx"
}

main() {
  ROLE="${MAGENT_ROLE:-client}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) ROLE="${2:-}"; shift 2 ;;
      --role=*) ROLE="${1#--role=}"; shift ;;
      *) die "bilinmeyen seçenek: $1" ;;
    esac
  done
  case "$ROLE" in
    client|gateway) ;;
    *) die "--role client veya gateway olmalı (verilen: $ROLE)" ;;
  esac

  command -v python3 >/dev/null 2>&1 || die "python3 gerekli (3.10 veya üzeri)"
  python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' || die "Python 3.10 veya üzeri gerekli"
  command -v curl >/dev/null 2>&1 || die "curl gerekli"

  # The client wizard asks questions, so it needs a terminal even when this script arrived through a pipe.
  if [ "$ROLE" = "client" ] && [ ! -r /dev/tty ]; then
    die "etkileşimli bir terminal gerekli; kurulumdan sonra 'magent client-setup' komutunu elle çalıştırın"
  fi

  ensure_pipx

  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT

  say "indiriliyor: $WHEEL"
  curl -fsSL -o "$TMP/$WHEEL" "$URL" </dev/null || die "indirilemedi: $URL"

  if command -v sha256sum >/dev/null 2>&1; then
    GOT="$(sha256sum "$TMP/$WHEEL" | cut -d' ' -f1)"
  else
    GOT="$(shasum -a 256 "$TMP/$WHEEL" | cut -d' ' -f1)"
  fi
  [ "$GOT" = "$SHA256" ] || die "SHA-256 eşleşmedi (beklenen $SHA256, gelen $GOT). Kurulum durduruldu, hiçbir şey kurulmadı."
  say "SHA-256 doğrulandı"

  "$PIPX" install --force "$TMP/$WHEEL" </dev/null
  "$PIPX" ensurepath </dev/null >/dev/null 2>&1 || true
  BIN_DIR="$("$PIPX" environment --value PIPX_BIN_DIR </dev/null 2>/dev/null || echo "$HOME/.local/bin")"
  MAGENT="$BIN_DIR/magent"
  [ -x "$MAGENT" ] || die "magent kurulamadı ($MAGENT bulunamadı)"

  if [ "$ROLE" = "gateway" ]; then
    if [ -n "${MAGENT_DATA_DIR:-}" ]; then
      "$MAGENT" gateway-setup --from-repo "$MAGENT_DATA_DIR" </dev/null
    else
      "$MAGENT" gateway-setup </dev/null
    fi
  else
    "$MAGENT" client-setup </dev/tty
  fi
}

main "$@"
